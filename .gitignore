# Publish only reviewed source, documentation, and selected examples.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/NOTICE.md
!/pyproject.toml
!/src/
!/tests/
!/mpv/
!/tools/
!/docs/
!/examples/
!/model/
!/.github/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.env.*
*.log
/model/*
!/model/subs2srs-plus/
/model/subs2srs-plus/*.original.*
/examples/*
!/examples/config.toml
!/examples/README.md
!/examples/yuruyuri/
!/examples/rezero/
